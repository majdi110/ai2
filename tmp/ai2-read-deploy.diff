new file mode 100644
--- /dev/null
+++ b/ai2/openapi.yaml
@@ -0,0 +1,188 @@
+openapi: 3.0.3
+info:
+  title: AI2 Job + Repo Read API (Node)
+  version: "1.1.0"
+  description: |
+    - Submit code patches (unified diff) for automated apply/commit/push by the AI2 worker.
+    - Read repository structure and files (safe, size-limited) so the client (ChatGPT) can craft accurate diffs.
+servers:
+  - url: https://datav.belocloud.com
+paths:
+  /ai2:
+    post:
+      operationId: submitJob
+      summary: Enqueue a patch job
+      security: [{ bearerAuth: [] }]
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              oneOf:
+                - $ref: '#/components/schemas/JobDiff'
+                - $ref: '#/components/schemas/JobDiffB64'
+      responses:
+        '202':
+          description: Accepted and queued
+          content:
+            application/json:
+              schema:
+                type: object
+                properties:
+                  queued: { type: boolean, example: true }
+                  job:    { type: string,  example: job-20250101T010203.json }
+                  hint:   { type: string }
+        '400': { description: Bad request }
+        '401': { description: Unauthorized }
+  /ai2/fs/list:
+    get:
+      operationId: listFiles
+      summary: List repository files/folders under a path
+      description: Depth-limited recursive listing; excludes .git, node_modules, and hidden files.
+      security: [{ bearerAuth: [] }]
+      parameters:
+        - in: query
+          name: path
+          schema: { type: string, default: "" }
+          description: Repo-relative directory ("" for repo root)
+        - in: query
+          name: depth
+          schema: { type: integer, minimum: 0, maximum: 3, default: 1 }
+          description: Recursion depth (max 3)
+      responses:
+        '200':
+          description: OK
+          content:
+            application/json:
+              schema:
+                type: object
+                properties:
+                  path:  { type: string }
+                  items:
+                    type: array
+                    items:
+                      type: object
+                      properties:
+                        path:  { type: string }
+                        type:  { type: string, enum: [file, dir] }
+                        size:  { type: integer }
+                        mtime: { type: integer, description: "unix seconds" }
+        '401': { description: Unauthorized }
+        '400': { description: Bad request }
+  /ai2/fs/get:
+    get:
+      operationId: getFile
+      summary: Get a single file (base64, size-capped)
+      security: [{ bearerAuth: [] }]
+      parameters:
+        - in: query
+          name: path
+          required: true
+          schema: { type: string }
+          description: Repo-relative file path
+      responses:
+        '200':
+          description: OK
+          content:
+            application/json:
+              schema:
+                type: object
+                properties:
+                  path:        { type: string }
+                  size:        { type: integer }
+                  mtime:       { type: integer }
+                  content_b64: { type: string }
+        '401': { description: Unauthorized }
+        '404': { description: Not found }
+        '413': { description: File too large }
+        '400': { description: Bad request }
+components:
+  securitySchemes:
+    bearerAuth:
+      type: http
+      scheme: bearer
+      bearerFormat: opaque
+  schemas:
+    JobBase:
+      type: object
+      required: [base_branch, message]
+      properties:
+        base_branch: { type: string, example: main }
+        message:     { type: string, example: "update endpoint and docs" }
+    JobDiff:
+      allOf:
+        - $ref: '#/components/schemas/JobBase'
+        - type: object
+          required: [diff]
+          properties:
+            diff:
+              type: string
+              description: Unified diff (must end with a newline)
+    JobDiffB64:
+      allOf:
+        - $ref: '#/components/schemas/JobBase'
+        - type: object
+          required: [diff_b64]
+          properties:
+            diff_b64:
+              type: string
+              description: Base64-encoded unified diff
