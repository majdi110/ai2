diff --git a/ai2/app.js b/ai2/app.js
--- a/ai2/app.js
+++ b/ai2/app.js
@@ -1,6 +1,196 @@
-// your existing AppJS ACTIVE (assumes Express app export)
+// AppJS ACTIVE – Node/Express app
+// Adds:
+//   POST /ai2                 -> enqueue job (diff or diff_b64)
+//   GET  /ai2/fs/list         -> list repo files (read-only)
+//   GET  /ai2/fs/get          -> get a file (base64, size-capped)
+// Uses token in /home/genweb/agent/ACTION_TOKEN
+
+const fs = require('fs');
+const path = require('path');
+const express = require('express');
+
+const app = module.exports = (global.app ? global.app : express()); // reuse if already created
+
+// ---- Config ----
+const REPO_ROOT  = '/home/genweb/public_html/datav.belocloud.com';
+const QUEUE_DIR  = '/home/genweb/agent/queue';
+const TOKEN_FILE = '/home/genweb/agent/ACTION_TOKEN'; // <- you have this file already
+const ALLOWED_ORIGINS = new Set(['https://datav.belocloud.com']);
+
+// Read endpoints safety
+const LIST_MAX_DEPTH = 3;
+const GET_MAX_BYTES  = 256 * 1024; // 256KB cap for reading a file
+const HIDDEN_DIRS = new Set(['.git', 'node_modules', '.cache', '.cpanel', '.trash']);
+const HIDDEN_TOP  = new Set(['.git', 'node_modules', '.env']);
+
+// Basic body parser
+app.use(express.json({ limit: '2mb' }));
+
+// Simple CORS
+app.use((req, res, next) => {
+  const o = req.headers.origin;
+  if (o && ALLOWED_ORIGINS.has(o)) {
+    res.setHeader('Access-Control-Allow-Origin', o);
+    res.setHeader('Vary', 'Origin');
+  }
+  if (req.method === 'OPTIONS') {
+    res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
+    res.setHeader('Access-Control-Allow-Headers', 'Authorization, Content-Type');
+    return res.status(204).end();
+  }
+  next();
+});
+
+function readToken() {
+  try { return fs.readFileSync(TOKEN_FILE, 'utf8').trim(); } catch (_) { return ''; }
+}
+function assertAuth(req, res) {
+  const expected = readToken();
+  const auth = req.headers['authorization'] || '';
+  const token = auth.toLowerCase().startsWith('bearer ') ? auth.slice(7) : '';
+  if (expected && token !== expected) {
+    res.status(401).json({ error: 'Unauthorized' });
+    return false;
+  }
+  return true;
+}
+function endsWithNewline(s) { return s.endsWith('\n'); }
+function safeJoin(root, userPath) {
+  const p = path.normalize('/' + (userPath || '').replace(/^\/+/, '')); // normalize & ensure relative
+  const full = path.join(root, '.' + p);
+  if (!full.startsWith(root)) throw new Error('path traversal rejected');
+  return full;
+}
+function isHiddenName(name) { return name.startsWith('.') && !['.htaccess','.htpasswd'].includes(name); }
+
+// ============ POST /ai2  (enqueue job) ============
+app.post('/ai2', (req, res) => {
+  if (!assertAuth(req, res)) return;
+  const { base_branch, message, diff, diff_b64 } = req.body || {};
+  if (!base_branch || typeof base_branch !== 'string') {
+    return res.status(400).json({ error: 'Missing base_branch' });
+  }
+  const commitMsg = (typeof message === 'string' && message.trim()) ? message : 'apply via API';
+  let payload;
+  if (typeof diff_b64 === 'string') {
+    try { payload = Buffer.from(diff_b64, 'base64').toString('utf8'); }
+    catch { return res.status(400).json({ error: 'diff_b64 not valid base64' }); }
+  } else if (typeof diff === 'string') {
+    payload = diff;
+  } else {
+    return res.status(400).json({ error: 'Provide diff_b64 or diff' });
+  }
+  if (!endsWithNewline(payload)) payload += '\n';
+  try { if (!fs.existsSync(QUEUE_DIR)) fs.mkdirSync(QUEUE_DIR, { recursive: true }); } catch { /*ignore*/ }
+  try { fs.accessSync(QUEUE_DIR, fs.constants.W_OK); } catch { return res.status(500).json({ error: 'Queue not writable' }); }
+  const job = { base_branch, message: commitMsg, ...(typeof diff_b64 === 'string' ? { diff_b64 } : { diff: payload }) };
+  const ts = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z');
+  const name = `job-${ts}.json`;
+  const tmp = path.join('/tmp', `ai2job.${process.pid}.${Date.now()}.json`);
+  const target = path.join(QUEUE_DIR, name);
+  try { fs.writeFileSync(tmp, JSON.stringify(job)); fs.renameSync(tmp, target); }
+  catch { try { fs.unlinkSync(tmp); } catch(_){}; return res.status(500).json({ error: 'Failed to enqueue job' }); }
+  return res.status(202).json({ queued: true, job: name, hint: 'worker.sh will apply, commit and push' });
+});
+
+// ============ GET /ai2/fs/list  (read-only) ============
+// Query: path (relative), depth (0..LIST_MAX_DEPTH)
+app.get('/ai2/fs/list', (req, res) => {
+  if (!assertAuth(req, res)) return;
+  const rel = (req.query.path ?? '').toString();
+  let depth = parseInt((req.query.depth ?? '1').toString(), 10);
+  if (isNaN(depth) || depth < 0) depth = 1;
+  if (depth > LIST_MAX_DEPTH) depth = LIST_MAX_DEPTH;
+  let root;
+  try { root = safeJoin(REPO_ROOT, rel); } catch { return res.status(400).json({ error: 'bad path' }); }
+  if (!fs.existsSync(root)) return res.json({ path: rel, items: [] });
+
+  function walk(dir, d, prefixRel) {
+    const out = [];
+    const entries = fs.readdirSync(dir, { withFileTypes: true });
+    for (const e of entries) {
+      if (HIDDEN_DIRS.has(e.name) || HIDDEN_TOP.has(e.name) || isHiddenName(e.name)) continue;
+      const abs = path.join(dir, e.name);
+      const relPath = path.posix.join(prefixRel, e.name);
+      try {
+        const st = fs.statSync(abs);
+        const item = { path: relPath, type: e.isDirectory() ? 'dir' : 'file', size: st.size, mtime: Math.floor(st.mtimeMs/1000) };
+        out.push(item);
+        if (e.isDirectory() && d > 0) out.push(...walk(abs, d-1, relPath));
+      } catch { /* ignore */ }
+    }
+    return out;
+  }
+  const items = walk(root, depth, rel.replace(/^\/+/, ''));
+  return res.json({ path: rel, items });
+});
+
+// ============ GET /ai2/fs/get  (read-only) ============
+// Query: path (relative to repo). Returns {path,size,mtime,content_b64}
+app.get('/ai2/fs/get', (req, res) => {
+  if (!assertAuth(req, res)) return;
+  const rel = (req.query.path ?? '').toString();
+  let abs;
+  try { abs = safeJoin(REPO_ROOT, rel); } catch { return res.status(400).json({ error: 'bad path' }); }
+  if (!fs.existsSync(abs)) return res.status(404).json({ error: 'not found' });
+  const st = fs.statSync(abs);
+  if (!st.isFile()) return res.status(400).json({ error: 'not a file' });
+  if (st.size > GET_MAX_BYTES) return res.status(413).json({ error: 'file too large', limit: GET_MAX_BYTES });
+  const buf = fs.readFileSync(abs);
+  return res.json({ path: rel, size: buf.length, mtime: Math.floor(st.mtimeMs/1000), content_b64: buf.toString('base64') });
+});
 
 // export for reuse by other modules / frameworks
 module.exports = app;
