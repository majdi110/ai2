import React from 'react';

const features = [
  { icon: '⚡', title: 'Fast Performance', description: 'Our SaaS delivers lightning fast speed with reliable uptime.' },
  { icon: '🔒', title: 'Secure', description: 'Top-level security features keep your data safe and private.' },
  { icon: '☁️', title: 'Cloud Based', description: 'Access your data anywhere, anytime from the cloud.' },
];

const pricingTiers = [
  {
    name: 'Basic',
    price: '$9/mo',
    features: ['1 Project', 'Basic Support', '100 MB Storage']
  },
  {
    name: 'Pro',
    price: '$29/mo',
    features: ['10 Projects', 'Priority Support', '1 GB Storage']
  },
  {
    name: 'Enterprise',
    price: 'Contact Us',
    features: ['Unlimited Projects', '24/7 Support', 'Unlimited Storage']
  }
];

function Hero() {
  return (
    <section className="hero">
      <h1>Welcome to SaaSify</h1>
      <p>Your all-in-one SaaS solution to boost productivity.</p>
      <button className="cta-button">Get Started</button>
    </section>
  );
}

function Features() {
  return (
    <section className="features">
      {features.map((feature) => (
        <div className="feature-card" key={feature.title}>
          <div className="feature-icon" aria-label={feature.title}>{feature.icon}</div>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </div>
      ))}
    </section>
  );
}

function Pricing() {
  return (
    <section className="pricing">
      {pricingTiers.map((tier) => (
        <div className="pricing-card" key={tier.name}>
          <h3>{tier.name}</h3>
          <p className="price">{tier.price}</p>
          <ul>
            {tier.features.map((feature, idx) => (
              <li key={idx}>{feature}</li>
            ))}
          </ul>
          <button className="price-button">Choose {tier.name}</button>
        </div>
      ))}
    </section>
  );
}

function ContactForm() {
  const [formData, setFormData] = React.useState({ name: '', email: '', message: '' });

  const handleChange = (e) => {
    const { name, value } = e.target;
    setFormData((prev) => ({ ...prev, [name]: value }));
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    alert(`Thank you, ${formData.name}! Your message has been received.`);
    setFormData({ name: '', email: '', message: '' });
  };

  return (
    <section className="contact">
      <h2>Contact Us</h2>
      <form onSubmit={handleSubmit}>
        <label>
          Name
          <input type="text" name="name" value={formData.name} onChange={handleChange} required />
        </label>
        <label>
          Email
          <input type="email" name="email" value={formData.email} onChange={handleChange} required />
        </label>
        <label>
          Message
          <textarea name="message" value={formData.message} onChange={handleChange} required />
        </label>
        <button type="submit">Send</button>
      </form>
    </section>
  );
}

function App() {
  return (
    <>
      <Hero />
      <Features />
      <Pricing />
      <ContactForm />
    </>
  );
}

export default App;

